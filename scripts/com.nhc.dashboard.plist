<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  NHC Dashboard LaunchAgent — keeps uvicorn running 24/7.
  Install: scripts/install-dashboard-service
  This is a TEMPLATE. The install script replaces __REPO_ROOT__ and __HOME__
  with actual paths before copying to ~/Library/LaunchAgents/.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nhc.dashboard</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO_ROOT__/admin-dashboard/.venv/bin/python</string>
        <string>-m</string>
        <string>uvicorn</string>
        <string>main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__/admin-dashboard/backend</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/nhc-dashboard/uvicorn.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/nhc-dashboard/uvicorn-error.log</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
